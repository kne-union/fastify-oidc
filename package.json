{
  "name": "@kne/fastify-oidc",
  "version": "0.1.0",
  "description": "基于 oidc-provider 的 Fastify OIDC 认证插件，支持 standalone / central 多项目单点登录、租户与跨项目令牌",
  "main": "index.js",
  "scripts": {
    "init": "husky",
    "build:md": "npx @kne/md-doc",
    "start:md": "npx @kne/md-doc --watch",
    "prettier": "prettier --config .prettierrc --write '{libs/**/*,index}.{js,jsx,ts,tsx,json,css,scss}'",
    "lint-staged": "npx lint-staged",
    "test": "mocha 'test/**/*.test.js'",
    "test:coverage": "nyc --reporter=html --reporter=text mocha 'test/**/*.test.js'"
  },
  "lint-staged": {
    "{libs/**/*,index}.{js,jsx,ts,tsx,json,css,scss}": [
      "prettier --config .prettierrc --write",
      "git add"
    ]
  },
  "files": [
    "index.js",
    "libs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kne-union/fastify-oidc.git"
  },
  "keywords": [
    "fastify",
    "oidc",
    "oauth2",
    "sso",
    "oidc-provider",
    "authentication",
    "jwt",
    "pkce",
    "dpop",
    "token-exchange",
    "multi-tenant",
    "kne"
  ],
  "author": "linzp",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kne-union/fastify-oidc/issues"
  },
  "homepage": "https://github.com/kne-union/fastify-oidc#readme",
  "peerDependencies": {
    "@kne/fastify-account": ">=2.0.8",
    "@kne/fastify-namespace": "*",
    "@kne/fastify-sequelize": "*",
    "fastify-plugin": ">=5"
  },
  "devDependencies": {
    "@fastify/env": "^5.0.2",
    "@kne/fastify-namespace": "^1.2.1",
    "@kne/fastify-sequelize": "^3.0.6",
    "chai": "^6.3.0",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "husky": "^9.0.11",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.3",
    "nyc": "^17.1.0",
    "oauth4webapi": "^3.8.8",
    "prettier": "^3.2.5",
    "sqlite3": "^5.1.7"
  },
  "dependencies": {
    "@kne/fastify-intl": "^0.1.5",
    "http-errors": "^2.0.1",
    "jose": "^6.2.12",
    "lodash": "^4.18.1",
    "oidc-provider": "^9.12.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependenciesMeta": {
    "@kne/fastify-account": {
      "optional": true
    }
  }
}
